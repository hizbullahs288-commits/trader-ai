rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAssetClass(val) {
      return val in ['CRYPTO', 'FOREX', 'STOCKS', 'GOLD'];
    }

    function isValidSide(val) {
      return val in ['LONG', 'SHORT'];
    }

    function isValidUserAccount(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.virtualBalance is number && data.virtualBalance >= 0 && data.virtualBalance <= 1000000000 &&
             data.initialCapital is number && data.initialCapital > 0 && data.initialCapital <= 1000000000 &&
             data.realizedPnl is number && data.realizedPnl >= -1000000000 && data.realizedPnl <= 1000000000 &&
             data.totalTrades is int && data.totalTrades >= 0 &&
             data.winningTrades is int && data.winningTrades >= 0 && data.winningTrades <= data.totalTrades &&
             data.defaultRiskPercent is number && data.defaultRiskPercent >= 0.1 && data.defaultRiskPercent <= 10.0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPaperPosition(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidAssetClass(data.assetClass) &&
             isValidSide(data.side) &&
             data.status in ['OPEN', 'CLOSED'] &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 100000000 &&
             data.entryPrice is number && data.entryPrice > 0 && data.entryPrice <= 100000000 &&
             (!('stopLoss' in data) || (data.stopLoss is number && data.stopLoss > 0 && data.stopLoss <= 100000000)) &&
             (!('takeProfit' in data) || (data.takeProfit is number && data.takeProfit > 0 && data.takeProfit <= 100000000)) &&
             (!('exitPrice' in data) || (data.exitPrice is number && data.exitPrice > 0 && data.exitPrice <= 100000000)) &&
             (!('realizedPnl' in data) || (data.realizedPnl is number && data.realizedPnl >= -1000000000 && data.realizedPnl <= 1000000000)) &&
             data.notes is string && data.notes.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('closedAt' in data) || (data.closedAt is timestamp && data.closedAt <= request.time));
    }

    function isValidJournalEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             isValidAssetClass(data.assetClass) &&
             isValidSide(data.side) &&
             data.entryPrice is number && data.entryPrice > 0 && data.entryPrice <= 100000000 &&
             data.exitPrice is number && data.exitPrice > 0 && data.exitPrice <= 100000000 &&
             data.quantity is number && data.quantity > 0 && data.quantity <= 100000000 &&
             data.pnlAmount is number && data.pnlAmount >= -1000000000 && data.pnlAmount <= 1000000000 &&
             data.pnlPercent is number && data.pnlPercent >= -100000 && data.pnlPercent <= 1000000 &&
             data.strategyTag is string && data.strategyTag.size() >= 1 && data.strategyTag.size() <= 40 &&
             data.emotionTag is string && data.emotionTag.size() >= 1 && data.emotionTag.size() <= 40 &&
             data.notes is string && data.notes.size() <= 1000 &&
             (!('linkedPositionId' in data) || isValidId(data.linkedPositionId)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'virtualBalance', 'initialCapital', 'realizedPnl',
                         'totalTrades', 'winningTrades', 'defaultRiskPercent', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'virtualBalance', 'initialCapital', 'realizedPnl',
                         'totalTrades', 'winningTrades', 'defaultRiskPercent', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserAccount(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'virtualBalance', 'realizedPnl', 'totalTrades', 'winningTrades', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'defaultRiskPercent', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'virtualBalance', 'initialCapital', 'realizedPnl', 'totalTrades', 'winningTrades', 'updatedAt'
                         ])
                       );

      allow delete: if false;

      match /positions/{positionId} {
        allow get: if isOwner(userId) && isValidId(positionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(positionId) &&
                         incoming().status == 'OPEN' &&
                         incoming().keys().hasAll([
                           'userId', 'symbol', 'displayName', 'assetClass', 'side',
                           'status', 'quantity', 'entryPrice', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'symbol', 'displayName', 'assetClass', 'side',
                           'status', 'quantity', 'entryPrice', 'stopLoss', 'takeProfit',
                           'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPaperPosition(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(positionId) &&
                         isValidPaperPosition(incoming()) &&
                         existing().status == 'OPEN' &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().symbol == existing().symbol &&
                         incoming().assetClass == existing().assetClass &&
                         incoming().side == existing().side &&
                         (
                           (
                             incoming().status == 'OPEN' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'stopLoss', 'takeProfit', 'notes', 'updatedAt'
                             ])
                           ) ||
                           (
                             incoming().status == 'CLOSED' &&
                             ('exitPrice' in incoming()) &&
                             ('realizedPnl' in incoming()) &&
                             ('closedAt' in incoming()) &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'exitPrice', 'realizedPnl', 'closedAt', 'updatedAt', 'notes'
                             ])
                           )
                         );

        allow delete: if isOwner(userId) && isValidId(positionId);
      }

      match /journal/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().keys().hasAll([
                           'userId', 'symbol', 'assetClass', 'side', 'entryPrice', 'exitPrice',
                           'quantity', 'pnlAmount', 'pnlPercent', 'strategyTag', 'emotionTag',
                           'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'symbol', 'assetClass', 'side', 'entryPrice', 'exitPrice',
                           'quantity', 'pnlAmount', 'pnlPercent', 'strategyTag', 'emotionTag',
                           'notes', 'linkedPositionId', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidJournalEntry(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidJournalEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'strategyTag', 'emotionTag', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(entryId);
      }
    }
  }
}
